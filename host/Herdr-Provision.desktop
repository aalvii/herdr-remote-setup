[Desktop Entry]
Version=1.0
Type=Application
Name=Herdr: Share This Computer
Comment=Show a 6-digit PIN so another computer can connect
Exec=sh -c "p=\${1#file://}; d=\$(dirname \"\$p\"); cd \"\$d\" && exec bash ./launch-pair.sh" sh %k
Icon=utilities-terminal
Terminal=false
Categories=Network;
StartupNotify=true
